# Copy this file to .env (root) for docker-compose, and/or into backend/.env,
# mock-ehr/.env, frontend/.env for running services individually.
# Never commit a real .env file.

# ---------- Backend ----------
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_prof
REDIS_URL=redis://localhost:6379

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# OpenAI (agent + realtime voice)
OPENAI_API_KEY=sk-replace-me
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview

# Mock EHR integration
MOCK_EHR_BASE_URL=http://localhost:4100
MOCK_EHR_API_KEY=dev-shared-secret
MOCK_EHR_TIMEOUT_MS=2500
INTEGRATION_MAX_RETRIES=2
INTEGRATION_RETRY_BASE_MS=200
RECONCILIATION_MAX_ATTEMPTS=3
# Set to "false" in tests so reconciliation is invoked explicitly.
RECONCILIATION_AUTO_RUN=true

FRONTEND_ORIGIN=http://localhost:5173

# ---------- Mock EHR service ----------
MOCK_EHR_PORT=4100
# MOCK_EHR_API_KEY shared with backend above

# ---------- Frontend ----------
VITE_API_BASE_URL=http://localhost:4000
